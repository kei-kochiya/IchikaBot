# ==========================================
# IchikaBot Environment Configuration
# ==========================================

# Required: Your Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Project Sekai Transfer-ID verify JWT secrets (for /pjsk sync)
PJSK_EN_INHERIT_TOKEN=
PJSK_JP_INHERIT_TOKEN=
